*.svd

# OS files
.DS_Store
Thumbs.db

# Crash / Report files
sysinfo.txt

# Build artifacts
*.apk
*.aab
*.xcodeproj/
*.xcworkspace/

# Unity Asset Store tools
Assets/AssetStoreTools*

# Auto-generated JetBrains Rider plugin
Assets/Plugins/Editor/JetBrains*

# Temporary auto-generated Android Gradle files
.gradle/
